#!/bin/bash

set -euo pipefail

trap 'echo "
##########################################################
# Test failed!
##########################################################" 1>&2' EXIT

TESTDIR=$(readlink -f $(dirname $0))
BUILDDIR=$(readlink -f ${BUILDDIR:-$(dirname $0)/../build})

export PATH=${BUILDDIR}:${BUILDDIR}/test:$PATH

echo "****************************************************"
echo "* Testing basic wrapper functionality..."
echo "****************************************************"
$TESTDIR/test-basic-wrapper/run-all-tests

echo "****************************************************"
echo "* Testing namespace sandboxing..."
echo "****************************************************"
$TESTDIR/test-namespaces/run-all-tests

echo "****************************************************"
echo "* Testing file descriptor passing..."
echo "****************************************************"
$TESTDIR/test-fd-passing/run-all-tests

trap - EXIT
echo "****************************************************"
echo "* All tests passed!"
echo "****************************************************"
